{
  "hosting": [
    {
      "target": "main",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.py",
        "**/*.env*",
        "**/*.yaml",
        "**/*.yml",
        "**/*.sh",
        "**/service-account*.json",
        "static_data*.json",
        "version.json"
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "run": {
            "serviceId": "golf-ai-web",
            "region": "asia-northeast3"
          }
        }
      ]
    },
    {
      "target": "legacy",
      "public": "public_legacy",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.py",
        "**/*.env*",
        "**/*.yaml",
        "**/*.yml",
        "**/*.sh",
        "**/service-account*.json"
      ],
      "rewrites": [
        {
          "source": "/admin/**",
          "run": {
            "serviceId": "golf-ai-web",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/api/**",
          "run": {
            "serviceId": "golf-ai-web",
            "region": "asia-northeast3"
          }
        }
      ]
    }
  ],
  "firestore": [
    {
      "database": "teetime",
      "rules": "firestore.rules"
    }
  ]
}
