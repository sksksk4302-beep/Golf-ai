rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 보안 강화: 클라이언트 SDK의 직접적인 Firestore 접근을 전면 차단합니다.
    // 모든 데이터 조회 및 조작은 백엔드 API (Cloud Run Admin SDK) 및 GCS 정적 데이터를 통해서만 수행됩니다.
    // 이를 통해 카카오 토큰(config/kakao), 프록시 주소(config/proxy), 시스템 로그 등의 유출을 차단합니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
